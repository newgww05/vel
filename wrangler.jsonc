// Settings for the Cloudflare Worker "vel" that publishes velcura.net from this repository.
// Pages are served as they are; a missing page shows 404.html instead of an empty page.
{
  "name": "vel",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
